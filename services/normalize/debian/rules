#!/usr/bin/make -f
BINARY ?= bin/normalize

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	install -D -m 0755 $(BINARY) debian/vulnmanager-normalize/usr/bin/vulnmanager-normalize
	install -D -m 0644 .env.example debian/vulnmanager-normalize/etc/vulnmanager/normalize/normalize.env

override_dh_strip:

override_dh_builddeb:
	dh_builddeb --destdir=dist

override_dh_dwz:
